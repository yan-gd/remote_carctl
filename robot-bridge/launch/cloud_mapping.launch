<launch>
  <!-- Headless SLAM, sharing the existing base and lidar. No RViz or second odometry. -->
  <node pkg="gmapping" type="slam_gmapping" name="web_slam_gmapping" output="screen" required="true">
    <param name="base_frame" value="base_link" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame" value="map" />
    <param name="map_update_interval" value="2.0" />
    <param name="delta" value="0.05" />
    <param name="xmin" value="-10.0" /><param name="ymin" value="-10.0" />
    <param name="xmax" value="10.0" /><param name="ymax" value="10.0" />
    <remap from="scan" to="/scan" />
  </node>
</launch>
