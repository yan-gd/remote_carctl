<launch>
  <!-- Reuse the already running chassis and lidar. No static map or AMCL. -->
  <arg name="scan_topic" default="/scan" />
  <node pkg="move_base" type="move_base" name="move_base" output="screen" clear_params="true">
    <rosparam file="$(dirname)/relative_navigation.yaml" command="load" />
    <param name="global_costmap/obstacles/scan/topic" value="$(arg scan_topic)" />
    <param name="local_costmap/obstacles/scan/topic" value="$(arg scan_topic)" />
    <remap from="cmd_vel" to="/navigation/cmd_vel" />
  </node>
</launch>
